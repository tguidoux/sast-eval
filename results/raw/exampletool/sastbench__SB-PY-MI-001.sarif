{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "exampletool",
          "rules": [
            {"id": "EXAMPLE-SSRF"},
            {"id": "EXAMPLE-CMD-INJECTION"}
          ]
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-SSRF",
          "level": "error",
          "message": {"text": "SSRF in preview_fetcher (TP: overlaps vulnerable region R2 + kind-matches ssrf)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "tools/preview_fetcher.py"},
                "region": {"startLine": 30}
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-CMD-INJECTION",
          "level": "error",
          "message": {"text": "Command injection in clinical_fetcher (capability FP: overlaps capability_safe region R1)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "tools/clinical_fetcher.py"},
                "region": {"startLine": 20}
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-SSRF",
          "level": "error",
          "message": {"text": "SSRF in a non-region file (plain FP: no region overlap)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "tools/other_fetcher.py"},
                "region": {"startLine": 5}
              }
            }
          ]
        }
      ]
    }
  ]
}
