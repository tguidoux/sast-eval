            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/main/java/org/owasp/benchmark/testcode/BenchmarkTest00001.java"},
                "region": {"startLine": 50}
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-PATH-TRAVERSAL",
          "level": "error",
