{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "exampletool",
          "rules": [
            {"id": "EXAMPLE-CMD-INJECTION"},
            {"id": "EXAMPLE-BAD-CWE"}
          ]
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-CMD-INJECTION",
          "level": "error",
          "message": {"text": "Command injection in funcs.c (TP: right file; CWE ignored — location-only)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/funcs.c"},
                "region": {"startLine": 25}
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-BAD-CWE",
          "level": "error",
          "message": {"text": "Finding in a different file (wrong file — should be FP)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "src/main.c"},
                "region": {"startLine": 10}
              }
            }
          ]
        }
      ]
    }
  ]
}
