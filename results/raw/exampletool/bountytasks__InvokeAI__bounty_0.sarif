{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "exampletool",
          "rules": [
            {"id": "EXAMPLE-INPUT-VALIDATION"},
            {"id": "EXAMPLE-SSRF"}
          ]
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE-INPUT-VALIDATION",
          "level": "error",
          "message": {"text": "Unvalidated input used in file path (TP: right file + right CWE)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "invokeai/app/services/image_files/image_files_disk.py"},
                "region": {"startLine": 88}
              }
            }
          ]
        },
        {
          "ruleId": "EXAMPLE-SSRF",
          "level": "error",
          "message": {"text": "SSRF in image service (wrong CWE — should be FP)"},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "invokeai/app/services/image_files/image_files_disk.py"},
                "region": {"startLine": 90}
              }
            }
          ]
        }
      ]
    }
  ]
}
